// Barkyard — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isHost        Boolean   @default(false)
  bio           String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  yards    Yard[]
  bookings Booking[] @relation("GuestBookings")
  reviews  Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Yard {
  id            String   @id @default(cuid())
  hostId        String
  title         String
  description   String
  neighborhood  String
  city          String
  state         String
  lat           Float
  lng           Float
  pricePerHour  Int
  sqft          Int
  fenceHeight   Int
  maxDogs       Int      @default(3)
  photos        String   // JSON array of URLs
  amenities     String   // JSON array of amenity keys
  rules         String?
  createdAt     DateTime @default(now())

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@index([city])
}

model Booking {
  id         String   @id @default(cuid())
  yardId     String
  guestId    String
  startTime  DateTime
  endTime    DateTime
  dogCount   Int
  totalPrice Int
  status     String   @default("confirmed") // confirmed, cancelled, completed
  createdAt  DateTime @default(now())

  yard  Yard @relation(fields: [yardId], references: [id], onDelete: Cascade)
  guest User @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Cascade)

  @@index([yardId])
  @@index([guestId])
}

model Review {
  id        String   @id @default(cuid())
  yardId    String
  guestId   String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  yard  Yard @relation(fields: [yardId], references: [id], onDelete: Cascade)
  guest User @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([yardId])
}
