# Local SQLite DB path (works on Vercel via /tmp at runtime if needed)
DATABASE_URL="file:./dev.db"

# NextAuth — generate a real secret for production: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-random-string"

# Google OAuth (optional — leave blank to hide the Google sign-in button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — when blank, checkout is stubbed and bookings are confirmed instantly)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
